# Synthetic local configuration for Docker Compose
APP_ENV=development
SECRET_KEY=synthetic-docker-compose-secret-key-not-for-production
DATABASE_URL=mysql+pymysql://securehire_app:synthetic-docker-db-password-local@db:3306/securehire_dev
