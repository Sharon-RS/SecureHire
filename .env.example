# Copy to .env and replace placeholders with local-only values.
APP_ENV=development
SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=mysql+pymysql://securehire_app:replace-me@127.0.0.1:3306/securehire_dev
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
SESSION_COOKIE_SECURE=false
# Vulnerability demonstrations remain gated off unless explicitly enabled.
LAB_ENABLE=false

# Required only by the synthetic seed command; choose a local-only value (12+ chars).
SECUREHIRE_DEMO_PASSWORD=replace-with-a-local-demo-password
